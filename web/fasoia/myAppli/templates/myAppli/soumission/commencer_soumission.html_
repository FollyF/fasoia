{% extends "base_app.html" %}
{% load static %}

{% block title %}FASOIA — Préparation de soumission{% endblock %}

{% block breadcrumb %}Soumission / {{ type_nom }}{% endblock %}

{% block content %}
<div class="card-edit">
    <div class="card-edit-head">
        <h3>📋 Préparation de votre candidature</h3>
        <p style="margin-top: 8px; font-size: 13px; color: var(--muted);">
            {{ type_nom }} - Référence #{{ opportunite.id }}
        </p>
    </div>

    <div style="padding: 20px;">
        <!-- Résumé de l'opportunité -->
        <div style="background: var(--cream); padding: 20px; margin-bottom: 24px; border-left: 4px solid var(--red);">
            <h4 style="margin-bottom: 12px; font-size: 16px;">Résumé de l'opportunité</h4>
            <p style="margin-bottom: 8px;"><strong>Description :</strong> {{ opportunite.description|default:"Non spécifiée" }}</p>
            {% if opportunite.date_limite %}
            <p><strong>Date limite :</strong> {{ opportunite.date_limite|date:"d/m/Y" }}</p>
            {% endif %}
        </div>

        <!-- ===== SECTION MATÉRIELS ===== -->
        <div style="background: var(--surface); padding: 20px; margin-bottom: 24px; border: 1px solid var(--border);">
            <h4 style="margin-bottom: 15px;">🛠️ Matériels & Équipements</h4>
            
            {% if materiels %}
            <table style="width:100%; margin-bottom: 15px; border-collapse: collapse;">
                <thead>
                    <tr style="background: var(--ink); color: white;">
                        <th style="padding: 8px; text-align: left;">Désignation</th>
                        <th style="padding: 8px; text-align: left;">Quantité</th>
                        <th style="padding: 8px; text-align: left;">État</th>
                        <th style="padding: 8px; text-align: left;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for materiel in materiels %}
                    <tr style="border-bottom: 1px solid var(--border);">
                        <td style="padding: 8px;">{{ materiel.designation }}</td>
                        <td style="padding: 8px;">{{ materiel.quantite }}</td>
                        <td style="padding: 8px;">{{ materiel.etat_fonctionnement }}</td>
                        <td style="padding: 8px;">
                            <form method="POST" style="margin:0;">
                                {% csrf_token %}
                                <input type="hidden" name="materiel_id" value="{{ materiel.id }}">
                                <button type="submit" name="supprimer_materiel" class="btn-app sm outline" style="background: var(--red); color: white; border: none;" onclick="return confirm('Supprimer ce matériel ?')">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p style="color: var(--hint); margin-bottom: 15px;">Aucun matériel renseigné.</p>
            {% endif %}
            
            <details style="margin-top: 10px;">
                <summary style="cursor: pointer; color: var(--red); font-weight: 600;">+ Ajouter un matériel</summary>
                <form method="POST" style="margin-top: 15px;">
                    {% csrf_token %}
                    <div class="form-grid-2">
                        <div class="form-field">
                            <label>Désignation du matériel</label>
                            <input type="text" name="designation" placeholder="Ex: Ordinateur portable" required>
                        </div>
                        <div class="form-field">
                            <label>Quantité</label>
                            <input type="number" name="quantite" value="1" required>
                        </div>
                        <div class="form-field">
                            <label>État de fonctionnement</label>
                            <select name="etat_fonctionnement">
                                <option value="Bon état">Bon état</option>
                                <option value="Très bon état">Très bon état</option>
                                <option value="Neuf">Neuf</option>
                                <option value="À réviser">À réviser</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label>Observations</label>
                            <input type="text" name="observations" placeholder="Optionnel">
                        </div>
                    </div>
                    <button type="submit" name="ajouter_materiel" class="btn-app sm outline" style="margin-top: 10px;">
                        <i class="fa fa-plus"></i> Ajouter
                    </button>
                </form>
            </details>
        </div>

        <!-- ===== SECTION PERSONNEL CLÉ ===== -->
        <div style="background: var(--surface); padding: 20px; margin-bottom: 24px; border: 1px solid var(--border);">
            <h4 style="margin-bottom: 15px;">👥 Personnel clé</h4>
            
            {% if personnels %}
            <table style="width:100%; margin-bottom: 15px; border-collapse: collapse;">
                <thead>
                    <tr style="background: var(--ink); color: white;">
                        <th style="padding: 8px; text-align: left;">Nom & Prénom</th>
                        <th style="padding: 8px; text-align: left;">Poste</th>
                        <th style="padding: 8px; text-align: left;">Qualification</th>
                        <th style="padding: 8px; text-align: left;">Années exp.</th>
                        <th style="padding: 8px; text-align: left;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for personnel in personnels %}
                    <tr style="border-bottom: 1px solid var(--border);">
                        <td style="padding: 8px;">{{ personnel.nom_prenom }}</td>
                        <td style="padding: 8px;">{{ personnel.poste }}</td>
                        <td style="padding: 8px;">{{ personnel.qualification }}</td>
                        <td style="padding: 8px;">{{ personnel.annees_experience }}</td>
                        <td style="padding: 8px;">
                            <form method="POST" style="margin:0;">
                                {% csrf_token %}
                                <input type="hidden" name="personnel_id" value="{{ personnel.id }}">
                                <button type="submit" name="supprimer_personnel" class="btn-app sm outline" style="background: var(--red); color: white; border: none;" onclick="return confirm('Supprimer ce personnel ?')">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p style="color: var(--hint); margin-bottom: 15px;">Aucun personnel renseigné.</p>
            {% endif %}
            
            <details style="margin-top: 10px;">
                <summary style="cursor: pointer; color: var(--red); font-weight: 600;">+ Ajouter un personnel</summary>
                <form method="POST" style="margin-top: 15px;">
                    {% csrf_token %}
                    <div class="form-grid-2">
                        <div class="form-field">
                            <label>Nom & Prénom</label>
                            <input type="text" name="nom_prenom" placeholder="Ex: KABORE Juste" required>
                        </div>
                        <div class="form-field">
                            <label>Poste</label>
                            <input type="text" name="poste" placeholder="Ex: Ingénieur en chef" required>
                        </div>
                        <div class="form-field">
                            <label>Qualification</label>
                            <input type="text" name="qualification" placeholder="Ex: Master en Génie Civil" required>
                        </div>
                        <div class="form-field">
                            <label>Années d'expérience</label>
                            <input type="number" name="annees_experience" value="0">
                        </div>
                    </div>
                    <button type="submit" name="ajouter_personnel" class="btn-app sm outline" style="margin-top: 10px;">
                        <i class="fa fa-plus"></i> Ajouter
                    </button>
                </form>
            </details>
        </div>

        <!-- ===== SECTION LETTRE DE MOTIVATION ===== -->
        <div style="background: var(--surface); padding: 20px; margin-bottom: 24px; border: 1px solid var(--border);">
            <h4 style="margin-bottom: 15px;">📝 Lettre de motivation</h4>
            
            <form method="POST" id="soumissionForm">
                {% csrf_token %}
                <div class="form-field">
                    <label class="required-star">Votre lettre de motivation</label>
                    <textarea name="lettre_motivation" rows="8" required 
                              placeholder="Madame, Monsieur,

Je soussigné, représentant légal de l'entreprise {{ entreprise.raisonSociale }}, ai l'honneur de soumettre ma candidature pour la présente opportunité.

Notre entreprise dispose des compétences et de l'expérience nécessaires pour mener à bien ce projet. Avec une équipe de {{ personnels.count }} professionnels qualifiés et un parc matériel adapté, nous sommes en mesure de répondre aux exigences techniques et administratives.

Dans l'attente d'une suite favorable, je vous prie d'agréer, Madame, Monsieur, l'expression de mes salutations distinguées.

Le Directeur Général"></textarea>
                </div>
                
                <!-- Vérification finale -->
                <div style="background: var(--cream); padding: 20px; margin: 20px 0;">
                    <h5>✅ Vérification finale</h5>
                    <ul style="margin-top: 12px;">
                        <li>✓ Matériel renseigné: <strong>{{ materiels|length }}</strong></li>
                        <li>✓ Personnel clé: <strong>{{ personnels|length }}</strong></li>
                        <li>✓ Lettre de motivation: <strong>{% if dossier.lettre_motivation or request.POST.lettre_motivation %}Remplie{% else %}À remplir{% endif %}</strong></li>
                    </ul>
                    {% if not has_materiel %}
                    <p style="color: var(--red); font-size: 12px; margin-top: 10px;">
                        ⚠️ Veuillez ajouter au moins un équipement/matériel
                    </p>
                    {% endif %}
                    {% if not has_personnel %}
                    <p style="color: var(--red); font-size: 12px;">
                        ⚠️ Veuillez ajouter au moins un personnel clé
                    </p>
                    {% endif %}
                </div>
                
                <div class="form-footer" style="margin-top: 20px;">
                    <a href="{% url 'myAppli:dashboard_entreprise' %}" class="btn-app outline">
                        <i class="fa fa-arrow-left"></i> Annuler
                    </a>
                    <button type="submit" name="soumettre_dossier" class="btn-app" 
                            {% if not has_materiel or not has_personnel %}disabled{% endif %}>
                        <i class="fa fa-paper-plane"></i> Soumettre ma candidature
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    details summary {
        cursor: pointer;
        padding: 8px 0;
        font-weight: 600;
    }
    details summary:hover {
        color: var(--red);
    }
    .btn-app.sm {
        padding: 6px 12px;
        font-size: 11px;
    }
    button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>
{% endblock %}