{% extends "base_app.html" %}
{% load static %}
{% block title %}FASOIA — Tableau de bord recruteur{% endblock %}
{% block breadcrumb %}Tableau de bord{% endblock %}

{% block app_extra_css %}
<style>
    /* Grille principale : 3 colonnes sur PC */
    .form-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 20px;
    }

    /* Grille secondaire : 2 colonnes (pour le profil ou les talents) */
    .form-grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

 /* ===== EN-TÊTE ===== */
  .dash-header {
    background: var(--ink);
    padding: 28px 32px;
    margin-bottom: 24px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    border-bottom: 3px solid var(--red);
  }
  .dash-header-left h1 {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    color: #862323;
    line-height: 1.1;
    margin-bottom: 10px;
  }
  .dash-header-left h1 span { color: var(--red); }
  .dash-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .dash-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border: 1px solid rgba(255,255,255,0.15);
    color: var(--ink);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
  }
  .dash-tag i { font-size: 10px; color: rgba(255,255,255,0.3); }
  
  .dash-header-right {
    text-align: right;
    flex-shrink: 0;
    min-width: 120px;
  }
  .dash-completion-num {
    font-family: var(--font-display);
    white-space: nowrap;
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    font-size: 48px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1;
  }
  .dash-completion-num span { color: var(--red); }
  .dash-completion-lbl {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--red);
    margin-top: 4px;
  }
  .dash-prog-track {
    height: 3px;
    background: rgba(255,255,255,0.1);
    margin-top: 10px;
    width: 120px;
    margin-left: auto;
    overflow: hidden;
  }
  .dash-prog-fill {
    height: 100%;
    background: var(--red);
    width: {{ progression }}%;
  }
    /* ===== CARTES DE GESTION DES OFFRES ===== */
    .manage-offer-card {
        background: var(--surface);
        border: 1px solid var(--border);
        padding: 20px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.2s ease;
        min-height: 220px;
    }
    .manage-offer-card:hover {
        border-color: var(--ink);
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

    .offer-status-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .status-badge {
        font-size: 9px;
        text-transform: uppercase;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 2px;
    }
    .status-badge.active { background: #e6fffa; color: #2c7a7b; border: 1px solid #b2f5ea; }
    .status-badge.closed { background: #fff5f5; color: #c53030; border: 1px solid #feb2b2; }

    .ref-id { font-family: monospace; font-size: 11px; color: var(--hint); }

    .offer-body h5 {
        font-size: 16px;
        font-weight: 700;
        color: var(--ink);
        margin: 0 0 8px 0;
    }

    .offer-meta {
        font-size: 12px;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 4px;
    }

    /* Actions en bas de carte */
    .offer-footer-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px solid var(--border);
    }

    .btn-manage {
        text-align: center;
        padding: 8px 5px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        text-decoration: none !important;
        border: 1px solid var(--border);
        color: var(--ink);
        transition: 0.2s;
    }
    .btn-manage.secondary:hover { background: var(--ink); color: white; }
    .btn-manage.danger { color: var(--red); border-color: var(--red); }
    .btn-manage.danger:hover { background: var(--red); color: white; }

    /* ===== BANNIÈRES & ONGLETS ===== */
    .success-banner {
        background: var(--surface);
        border-left: 3px solid var(--teal);
        padding: 16px 20px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 14px;
        border-top: 1px solid var(--border);
        border-right: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }

    .tabs-nav {
        display: flex;
        border-bottom: 2px solid var(--ink);
        overflow-x: auto;
        white-space: nowrap;
    }
    .tab-btn {
        padding: 12px 20px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--muted);
        background: none;
        border: none;
        cursor: pointer;
    }
    .tab-btn.active { color: var(--ink); border-bottom: 3px solid var(--red); }

    /* ===== SYSTÈME VOIR PLUS ===== */
    .expandable-wrapper {
        max-height: 520px; /* Environ 2 lignes de cartes */
        overflow: hidden;
        position: relative;
        transition: max-height 0.5s cubic-bezier(0, 1, 0, 1); /* Transition fluide */
    }

    .expandable-wrapper.expanded {
        max-height: 5000px; /* Valeur haute pour permettre l'extension */
        transition: max-height 0.5s ease-in-out;
    }

    /* Dégradé pour suggérer qu'il y a du contenu en dessous */
    .expandable-wrapper::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 80px;
        background: linear-gradient(transparent, var(--surface));
        pointer-events: none;
        transition: opacity 0.3s;
    }

    .expandable-wrapper.expanded::after {
        opacity: 0; /* On cache le dégradé quand c'est ouvert */
    }

    .view-more-container {
        text-align: center;
        margin-top: 15px;
    }

    .btn-view-more {
        background: none;
        border: none;
        color: var(--red);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
    }

    .btn-view-more:hover {
        text-decoration: underline;
    }

    .btn-view-more i {
        transition: transform 0.3s;
    }

    .btn-view-more.active i {
        transform: rotate(180deg);
    }

    /* ===== RESPONSIVE ===== */
    
    /* Tablettes : 2 colonnes */
    @media (max-width: 1100px) {
        .form-grid-3 { grid-template-columns: repeat(2, 1fr); }
    }

    /* Mobiles : 1 colonne partout */
    @media (max-width: 768px) {
        .dash-header { 
            padding: 20px; 
        }
        
        .dash-header-left h1 {
          font-size: 26px;
        }
        
        .dash-completion-num {
          font-size: 38px;
        }

        .form-grid-3, .form-grid-2 { 
            grid-template-columns: 1fr !important; 
        }

        .offer-footer-actions {
            grid-template-columns: 1fr; /* Boutons empilés sur mobile */
        }
    }

    /* Utilitaires */
    .fa-spin { animation: fa-spin 1s infinite linear; }
    @keyframes fa-spin { from {transform:rotate(0deg)} to {transform:rotate(360deg)} }
</style>
{% endblock %}

{% block content %}
<!-- EN-TÊTE DASHBOARD -->
<div class="dash-header">
    <div class="dash-header-left">
        <h1>Bienvenue, <span>{{ recruteur.organisation|default:"Recruteur" }}</span></h1>
        <div class="dash-tags">
            <div class="dash-tag">
                <i class="fa fa-user-tie"></i>
                {{ recruteur.poste_occupe|default:"Recruteur" }}
            </div>
            <div class="dash-tag">
                <i class="fa fa-building"></i>
                {{ recruteur.organisation|default:"Organisation non définie" }}
            </div>
        </div>
    </div>
    <div class="dash-header-right">
        <div class="dash-completion-num">{{ progression }}<span>%</span></div>
        <div class="dash-completion-lbl">Profil complété</div>
        <div class="dash-prog-track">
            <div class="dash-prog-fill"></div>
        </div>
    </div>
</div>

<!-- STATISTIQUES -->
<div class="stats-row" style="margin-bottom:24px">
    <div class="stat-cell">
        <div class="n">{{ stats.offres_publiees|default:0 }}</div>
        <div class="l">Offres publiées</div>
    </div>
    <div class="stat-cell">
        <div class="n">{{ stats.candidatures_recues|default:0 }}</div>
        <div class="l">Candidatures reçues</div>
    </div>
    <div class="stat-cell accent">
        <div class="n">{{ talents_recommandes|length|default:0 }}</div>
        <div class="l">Talents recommandés</div>
    </div>
    <div class="stat-cell">
        <div class="n">0</div>
        <div class="l">Entretiens planifiés</div>
    </div>
</div>

<!-- BANNER PROFIL COMPLET -->
{% if profil_complet %}
<div class="success-banner">
    <i class="fa fa-circle-check"></i>
    <div>
        <strong>Profil recruteur complété à 100%</strong>
        <p>Vous pouvez maintenant publier des offres et recevoir des recommandations de talents.</p>
    </div>
    <button class="btn-app sm outline" onclick="toggleEditMode()">
        <i class="fa fa-pen"></i> Modifier
    </button>
</div>
{% endif %}

<!-- FORMULAIRE DE COMPLÉTION DU PROFIL -->
<div class="card-edit" id="profile-form-section" {% if profil_complet %}style="display:none;"{% endif %}>
    <div class="card-edit-head">
        <h3>{% if profil_complet %}Modifier{% else %}Compléter{% endif %} votre profil recruteur</h3>
        <span style="font-size:11px;color:var(--hint)">
            <span style="color:var(--red)">*</span> Champs obligatoires
        </span>
    </div>

    <form method="POST" action="{% url 'myAppli:completer_profil_recruteur' %}" id="profile-form">
        {% csrf_token %}
        <div class="form-grid-2">
            <div class="form-field">
                <label class="required-star">Organisation / Entreprise</label>
                <input type="text" name="organisation" value="{{ recruteur.organisation }}" placeholder="Nom de votre organisation" required>
            </div>
            <div class="form-field">
                <label class="required-star">Secteur d'activité</label>
                <input type="text" name="secteur" value="{{ recruteur.secteur }}" placeholder="Ex: Technologies, Finance, BTP..." required>
            </div>
            <div class="form-field">
                <label class="required-star">Type de structure</label>
                <select name="typeStructure" required>
                    <option value="">Sélectionnez...</option>
                    <option value="PME" {% if recruteur.typeStructure == 'PME' %}selected{% endif %}>PME</option>
                    <option value="Grande entreprise" {% if recruteur.typeStructure == 'Grande entreprise' %}selected{% endif %}>Grande entreprise</option>
                    <option value="Startup" {% if recruteur.typeStructure == 'Startup' %}selected{% endif %}>Startup</option>
                    <option value="Administration" {% if recruteur.typeStructure == 'Administration' %}selected{% endif %}>Administration</option>
                    <option value="ONG" {% if recruteur.typeStructure == 'ONG' %}selected{% endif %}>ONG</option>
                </select>
            </div>
            <div class="form-field">
                <label class="required-star">Poste occupé</label>
                <input type="text" name="poste_occupe" value="{{ recruteur.poste_occupe }}" placeholder="Ex: DRH, Talent Acquisition..." required>
            </div>
            <div class="form-field full">
                <label class="required-star">Secteurs recherchés</label>
                <input type="text" name="secteurs_recherches" value="{{ recruteur.secteurs_recherches|join:', ' }}" placeholder="Informatique, Finance, Marketing..." required>
                <div class="field-note">Séparez par des virgules</div>
            </div>
            <div class="form-field full">
                <label class="required-star">Types de contrats proposés</label>
                <input type="text" name="types_contrats_proposes" value="{{ recruteur.types_contrats_proposes|join:', ' }}" placeholder="CDI, CDD, Stage, Freelance..." required>
                <div class="field-note">Séparez par des virgules</div>
            </div>
        </div>

        <div class="form-footer">
            <button type="submit" class="btn-app" id="submit-btn">
                <i class="fa fa-save"></i> Enregistrer le profil
            </button>
        </div>
    </form>
</div>

<!-- SECTION OFFRES PUBLIÉES -->
<div class="card-edit">
    <div class="card-edit-head d-flex justify-content-between align-items-center">
        <h3>Mes offres publiées ({{ offres_publiees|length }})</h3>
        <button class="btn-app sm" onclick="toggleOffreForm()">
            <i class="fa fa-plus"></i> Publier une offre
        </button>
    </div>

    {% if offres_publiees %}
    <div class="expandable-wrapper" id="offersWrapper">
        <div class="form-grid-3">
            {% for offre in offres_publiees %}
            <div class="manage-offer-card">
                <div class="offer-status-bar">
                    <span class="status-badge {% if offre.est_active %}active{% else %}closed{% endif %}">
                        {% if offre.est_active %}En ligne{% else %}Hors ligne{% endif %}
                    </span>
                    <span class="ref-id">#{{ offre.id }}</span>
                </div>

                <div class="offer-body">
                    <h5>{{ offre.titre }}</h5>
                    <p class="offer-meta">
                        <span><i class="fa fa-map-marker-alt"></i> {{ offre.localisation }}</span>
                    </p>
                    <p class="offer-meta">
                         <span><i class="fa fa-users"></i> <strong>{{ offre.candidatures.count|default:0 }}</strong> candidats</span>
                    </p>
                </div>

                <div class="offer-footer-actions">
                    <a href="{% url 'myAppli:detail_emploi' offre.id %}" class="btn-manage secondary">Voir</a>
                    <a href="#" class="btn-manage danger">Fermer</a>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- Bouton Voir Plus / Voir Moins -->
    {% if offres_publiees|length > 6 %}
    <div class="view-more-container">
        <button class="btn-view-more" id="btnToggleOffers" onclick="toggleViewMore()">
            <span class="txt">Voir toutes les offres</span>
            <i class="fa fa-chevron-down"></i>
        </button>
    </div>
    {% endif %}

{% else %}
    <p style="padding:40px; text-align:center; color:var(--hint); font-style:italic; border: 2px dashed var(--border);">
        Vous n'avez pas encore publié d'offre.
    </p>
{% endif %}
</div>

<!-- TALENTS RECOMMANDÉS -->
<div class="card-edit">
    <div class="card-edit-head">
        <h3>Talents recommandés</h3>
    </div>

    {% if talents_recommandes %}
        <!-- Ici tu peux ajouter des filtres plus tard si besoin -->
        <div class="row">
            {% for talent in talents_recommandes %}
            <div class="col-md-6 mb-3">
                <div class="candidat-card">
                    <div class="d-flex justify-content-between">
                        <h5>{{ talent.prenom }} {{ talent.nom }}</h5>
                        <span class="match-badge">{{ talent.score|default:75 }}%</span>
                    </div>
                    <p class="text-muted">{{ talent.competences|truncatechars:120 }}</p>
                    <div class="btn-actions">
                        <a href="#" class="btn-app sm outline">Voir profil</a>
                        <a href="#" class="btn-app sm">Contacter</a>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    {% else %}
        <div style="padding:40px 20px; text-align:center; color:var(--hint);">
            Aucun talent recommandé pour le moment.
        </div>
    {% endif %}
</div>
{% endblock %}

{% block extra_js %}
<script>

function toggleViewMore() {
    const wrapper = document.getElementById('offersWrapper');
    const btn = document.getElementById('btnToggleOffers');
    const btnTxt = btn.querySelector('.txt');
    
    wrapper.classList.toggle('expanded');
    btn.classList.toggle('active');
    
    if (wrapper.classList.contains('expanded')) {
        btnTxt.innerText = "Réduire la liste";
    } else {
        btnTxt.innerText = "Voir toutes les offres";
        // Optionnel : remonter doucement au début de la section
        wrapper.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
}
    
function toggleEditMode() {
    const section = document.getElementById('profile-form-section');
    if (section.style.display === 'none' || section.style.display === '') {
        section.style.display = 'block';
        section.scrollIntoView({ behavior: 'smooth' });
    } else {
        section.style.display = 'none';
    }
}

function toggleOffreForm() {
    alert("Fonctionnalité de publication d'offre en cours de développement.\n\nTu peux créer une page dédiée pour publier une offre.");
    // Plus tard : rediriger vers une page de création d'offre
    // window.location.href = "{% url 'myAppli:publier_offre_emploi' %}";
}

// Loader sur soumission du profil
const form = document.getElementById('profile-form');
if (form) {
    form.addEventListener('submit', function() {
        const btn = document.getElementById('submit-btn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Enregistrement...';
    });
}
</script>
{% endblock %}