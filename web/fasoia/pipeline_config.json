{
    "nom_pipeline": "Pipeline UEMOA + DGCMEF",
    "version": "2.0.0",
    
    "etapes": {
        "scraping_uemoa": {
            "description": "Scraping des AMI et offres UEMOA",
            "commandes": [
                {
                    "type": "django",
                    "commande": "uemoa_ami_to_db",
                    "description": "Import des AMI UEMOA"
                },
                {
                    "type": "django",
                    "commande": "uemoa_offre_to_db",
                    "description": "Import des offres UEMOA"
                }
            ]
        },
        
        "scraping_dgcmef": {
            "description": "Scraping des offres DGCMEF (Burkina Faso)",
            "commandes": [
                {
                    "type": "python",
                    "chemin": "myAppli/utils/web_scraper/dgcmef_scraper.py",
                    "args": [],
                    "description": "Téléchargement des PDFs DGCMEF"
                }
            ]
        },
        
        "analyse": {
            "description": "Analyse des PDFs avec l'IA",
            "commandes": [
                {
                    "type": "python",
                    "chemin": "analyse_ia/analyser_pdfs.py",
                    "args": [],
                    "description": "Analyse des PDFs téléchargés"
                }
            ]
        },
        
        "extraction_uemoa": {
            "description": "Extraction des éléments des PDFs UEMOA",
            "commandes": [
                {
                    "type": "python",
                    "chemin": "analyse_ia/extraire_elements.py",
                    "args": [],
                    "description": "Extraction des données structurées UEMOA"
                }
            ]
        },
        
        "extraction_dgcmef": {
            "description": "Extraction des offres des PDFs DGCMEF",
            "commandes": [
                {
                    "type": "python",
                    "chemin": "analyse_ia/extraireQuotidien.py",
                    "args": [],
                    "description": "Extraction des offres DGCMEF"
                }
            ]
        },
        
        "injection_dgcmef": {
            "description": "Injection des offres DGCMEF en base",
            "commandes": [
                {
                    "type": "django",
                    "commande": "dgcmef_to_db",
                    "description": "Injection dans les tables UEMOA"
                }
            ]
        },

        "recommandation": {
            "description": "Matching IA des offres",
            "commandes": [
                {
                    "type": "python",
                    "chemin": "analyse_ia/moteur_recommandation.py",
                    "args": []
                }
            ]
        }
    },
    
    "pipelines": {
        "all": {
            "description": "Exécute tout le pipeline (UEMOA + DGCMEF)",
            "etapes": ["scraping_uemoa", "scraping_dgcmef", "analyse", "extraction_uemoa", "extraction_dgcmef", "injection_dgcmef"]
        },
        "uemoa": {
            "description": "Exécute uniquement le pipeline UEMOA",
            "etapes": ["scraping_uemoa", "analyse", "extraction_uemoa"]
        },
        "dgcmef": {
            "description": "Exécute uniquement le pipeline DGCMEF",
            "etapes": ["scraping_dgcmef", "extraction_dgcmef", "injection_dgcmef"]
        },
        "recommandation_only": {
            "description": "Exécute uniquement la recommandation",
            "etapes": ["recommandation"]
        }
    },
    
    "options": {
        "stop_on_error": true,
        "log_level": "INFO"
    }
}